{
  "name": "@tradereplay/egx100-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chromium automation for downloading EGX100 daily OHLCV history from Investing.com.",
  "scripts": {
    "auth": "tsx src/cli.ts login",
    "login:investing": "tsx src/cli.ts login",
    "components": "tsx src/cli.ts components",
    "download": "tsx src/cli.ts download --mode full",
    "download:append": "tsx src/cli.ts download --mode append",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "playwright-core": "^1.56.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "csv-parse": "^7.0.3"
  }
}
